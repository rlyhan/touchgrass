# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is gitignored.

# Neon PostgreSQL — use the pooled connection string
DATABASE_URL=

# better-auth — generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated allowed client origins (leave empty for local dev)
# Example for production: https://touchgrass-mobile.vercel.app,https://touchgrass-api-81dp.onrender.com
BETTER_AUTH_TRUSTED_ORIGINS=

# Sanity CMS
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
